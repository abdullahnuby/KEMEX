{
  "name": "kemex-web",
  "private": true,
  "version": "0.52.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:db": "node --test tests/db/rls.test.mjs tests/db/driver-execution.test.mjs tests/db/gps-tracking.test.mjs",
    "test:driver": "node --test tests/frontend/driver-execution-contract.test.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "test:source": "node --test tests/frontend/source-integrity.test.mjs",
    "test:security": "node --test tests/db/action-authorization.test.mjs tests/frontend/permission-matrix.test.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "test:security:static": "node --test tests/frontend/permission-matrix.test.mjs",
    "test:enterprise-sprint": "node --test tests/enterprise/sprint-052.test.mjs tests/frontend/gps-tracking-contract.test.mjs tests/frontend/notifications-contract.test.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "test:map": "node --test tests/frontend/location-map-picker.test.mjs",
    "test:gps": "node --test tests/db/gps-tracking.test.mjs tests/frontend/gps-tracking-contract.test.mjs",
    "test:notifications": "node --test tests/frontend/notifications-contract.test.mjs",
    "test:data-protection": "node --test tests/enterprise/data-protection.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.103.2",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
